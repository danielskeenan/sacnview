{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://sacnview.org/sacncnap.schema.json",
  "title": "sACNView Snapshot",
  "description": "Contents of an sACN snapshot",
  "type": "array",
  "items": {
    "title": "Universe entry",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 63
      },
      "priority": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200
      },
      "universe": {
        "type": "integer",
        "minimum": 1,
        "maximum": 63999
      },
      "values": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "required": ["name", "priority", "universe", "values"]
  }
}
